# Copy to backend/.env and fill in local values.

JWT_SECRET_KEY=replace-with-a-long-random-secret
INTERNAL_TEST_DEPOSIT_KEY=replace-with-a-development-only-key

# Ethereum Sepolia deposit monitoring
# Sepolia chain ID: 11155111
ETHEREUM_SEPOLIA_RPC_URL=https://rpc.sepolia.dev
ETHEREUM_SEPOLIA_USDT_CONTRACT=replace-with-your-sepolia-erc20-usdt-contract
ETHEREUM_SEPOLIA_NETWORK=ETHEREUM_SEPOLIA
ETHEREUM_SEPOLIA_ASSET_SYMBOL=USDT
ETHEREUM_DEPOSIT_REQUIRED_CONFIRMATIONS=3
ETHEREUM_DEPOSIT_POLL_SECONDS=15
ETHEREUM_DEPOSIT_LOOKBACK_BLOCKS=200
ETHEREUM_DEPOSIT_LOG_CHUNK_SIZE=50
